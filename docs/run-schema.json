{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joeyvictorino/assay/docs/run-schema.json",
  "title": "Assay RunReport",
  "description": "Schema for the run.json file produced by `assay run`. Describes the committed summary of a multi-model security validation run.",
  "type": "object",
  "required": [
    "run_id", "git_sha", "mode", "started", "finished", "scope",
    "models", "labs", "audit_head_hash", "audit_record_count",
    "budget_cap_usd", "spent_usd", "truncated", "verdict", "exit_code"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this run."
    },
    "git_sha": {
      "type": "string",
      "description": "Git commit SHA of the codebase under test."
    },
    "ci_run_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the CI job that triggered this run."
    },
    "mode": {
      "type": "string",
      "enum": ["full", "degraded"],
      "description": "Whether all models completed (full) or some failed over (degraded)."
    },
    "config": {
      "type": "string",
      "description": "Run configuration name."
    },
    "label": {
      "type": "string",
      "description": "Human label for the run configuration, e.g. which kind of models ran."
    },
    "started": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run began."
    },
    "finished": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run completed."
    },
    "scope": { "$ref": "#/$defs/Decision" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModelResult" },
      "description": "Per-model summary of findings, usage and latency."
    },
    "labs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lab identifiers exercised in this run."
    },
    "overlap": {
      "$ref": "#/$defs/OverlapMatrix",
      "description": "Cross-model overlap analysis."
    },
    "precision": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/PRF" },
      "description": "Per-model precision/recall/F1 against ground-truth labs."
    },
    "chains": {
      "type": "array",
      "items": { "$ref": "#/$defs/AttackPath" },
      "description": "Attack paths chaining findings to objectives."
    },
    "reflection": {
      "type": "array",
      "items": { "$ref": "#/$defs/ReflectionResult" },
      "description": "Self- and peer-review scoring results."
    },
    "reconcile_reason_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" },
      "description": "Count of findings by reconciliation mismatch reason."
    },
    "policy_denies_by_reason": {
      "type": "object",
      "additionalProperties": { "type": "integer" },
      "description": "Count of policy denials by reason code."
    },
    "audit_head_hash": {
      "type": "string",
      "description": "Hash of the last audit-log record, forming a hash chain."
    },
    "audit_record_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total audit-log records written during this run."
    },
    "budget_cap_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum spend allowed for this run in USD."
    },
    "spent_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Actual spend for this run in USD."
    },
    "truncated": {
      "type": "boolean",
      "description": "Whether the run was cut short (budget or time limit)."
    },
    "weighted_score": {
      "type": "number",
      "description": "Composite score weighted by policy checker weights."
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "ERROR"],
      "description": "Final run outcome."
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "Process exit code: 0 pass, 1 blocked, 2 error."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Decision": {
      "type": "object",
      "description": "Policy or gate outcome with a machine reason and human rationale.",
      "required": ["effect", "reason", "rationale"],
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["allow", "deny"],
          "description": "Policy effect. Deny always wins."
        },
        "reason": {
          "type": "string",
          "description": "Machine-readable reason code, e.g. DENY_RULE:no-write-in-recon."
        },
        "rationale": {
          "type": "string",
          "description": "Human-readable explanation of the decision."
        },
        "matched_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Policy rule IDs that matched."
        },
        "policy_hash": {
          "type": "string",
          "description": "SHA-256 of the policy document used."
        }
      },
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "description": "Identifies which model, provider and agent produced something.",
      "required": ["provider", "model", "agent"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "agent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "description": "Token and cost accounting for one model.",
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd", "latency_ms"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ModelResult": {
      "type": "object",
      "description": "Summary of one model's run.",
      "required": ["ref", "findings_by_state", "usage", "p50_ms", "p95_ms", "refusals", "failovers"],
      "properties": {
        "ref": { "$ref": "#/$defs/ModelRef" },
        "findings_by_state": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "Finding counts keyed by state (theorized, validated, refuted, declined)."
        },
        "usage": { "$ref": "#/$defs/Usage" },
        "p50_ms": { "type": "integer", "minimum": 0, "description": "Median latency in milliseconds." },
        "p95_ms": { "type": "integer", "minimum": 0, "description": "95th percentile latency in milliseconds." },
        "refusals": { "type": "integer", "minimum": 0, "description": "Number of model refusals." },
        "failovers": { "type": "integer", "minimum": 0, "description": "Number of failovers to alternate models." }
      },
      "additionalProperties": false
    },
    "PairCell": {
      "type": "object",
      "description": "One cell of the pairwise overlap matrix.",
      "required": ["both", "only_a", "only_b", "jaccard"],
      "properties": {
        "both": { "type": "integer", "minimum": 0 },
        "only_a": { "type": "integer", "minimum": 0 },
        "only_b": { "type": "integer", "minimum": 0 },
        "jaccard": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "FileDigest": {
      "type": "object",
      "description": "Input file hash for reproducibility.",
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": { "type": "string" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "OverlapMatrix": {
      "type": "object",
      "description": "Cross-model overlap analysis result.",
      "required": ["models", "keys", "membership", "pairwise", "unique_per_model", "union", "intersection", "inputs"],
      "properties": {
        "models": { "type": "array", "items": { "type": "string" } },
        "keys": { "type": "array", "items": { "type": "string" } },
        "membership": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "pairwise": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/PairCell" }
          }
        },
        "unique_per_model": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "union": { "type": "integer", "minimum": 0 },
        "intersection": { "type": "integer", "minimum": 0 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/FileDigest" } }
      },
      "additionalProperties": false
    },
    "PRF": {
      "type": "object",
      "description": "Precision, recall and F1 against ground truth.",
      "required": ["tp", "fp", "fn", "precision", "recall", "f1"],
      "properties": {
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "PathStep": {
      "type": "object",
      "description": "One hop in an attack path.",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["finding", "precondition", "fact", "objective"]
        },
        "id": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AttackPath": {
      "type": "object",
      "description": "Chain of findings leading to an objective.",
      "required": ["id", "lab", "objective", "path", "confidence", "source_refs"],
      "properties": {
        "id": { "type": "string" },
        "lab": { "type": "string" },
        "objective": {
          "type": "string",
          "enum": ["account-takeover", "data-access", "privilege-escalation", "code-exec"]
        },
        "path": { "type": "array", "items": { "$ref": "#/$defs/PathStep" } },
        "confidence": {
          "type": "string",
          "enum": ["theorized", "validated", "refuted", "declined"],
          "description": "Minimum confidence over path steps."
        },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ReflectionResult": {
      "type": "object",
      "description": "Self- or peer-review scoring result for one lab/model pair.",
      "required": ["lab", "model", "scored", "revisions", "passed", "validated", "refuted", "theorized"],
      "properties": {
        "lab": { "type": "string" },
        "model": { "type": "string", "description": "Model that was assessed." },
        "reviewer": { "type": "string", "description": "Model that performed the review." },
        "reviewer_kind": {
          "type": "string",
          "enum": ["self", "peer"],
          "description": "Whether the reviewer is the same model (self) or a different one (peer)."
        },
        "prompt_variant": { "type": "string", "description": "Prompt variant name from config." },
        "scored": { "type": "boolean" },
        "scores": { "type": "array", "items": { "type": "integer" } },
        "revisions": { "type": "integer", "minimum": 0 },
        "final_score": { "type": "integer" },
        "passed": { "type": "boolean" },
        "validated": { "type": "integer", "minimum": 0, "description": "Findings confirmed by deterministic checkers." },
        "refuted": { "type": "integer", "minimum": 0, "description": "Findings disproved by deterministic checkers." },
        "theorized": { "type": "integer", "minimum": 0, "description": "Findings not yet checked." },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
