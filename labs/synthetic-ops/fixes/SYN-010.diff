+// debugConfig reports non-sensitive build information to authenticated
+// administrators only. Credentials never appear in any response.
+func (s *Server) debugConfig(w http.ResponseWriter, r *http.Request) {
+	uid := s.currentUser(r)
+	if uid == 0 {
+		writeJSON(w, http.StatusUnauthorized, map[string]any{"error": "login required"})
+		return
+	}
+	var role string
+	if err := s.db.QueryRow(`SELECT role FROM users WHERE id = ?`, uid).Scan(&role); err != nil || role != "admin" {
+		writeJSON(w, http.StatusForbidden, map[string]any{"error": "administrator role required"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{
+		"service": "synthetic-ops",
+		"debug":   false,
 	})
 }
 
